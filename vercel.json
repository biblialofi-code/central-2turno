{
  "outputDirectory": "site",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dia-25",
      "destination": "/dia-25.html"
    },
    {
      "source": "/acompanha",
      "destination": "/api/acompanha"
    },
    {
      "source": "/deputado/:slug",
      "destination": "/api/acompanha?slug=:slug"
    },
    {
      "source": "/apuracao",
      "destination": "/apuracao.html"
    },
    {
      "source": "/propostas",
      "destination": "/propostas.html"
    },
    {
      "source": "/ig/story/:id.jpg",
      "destination": "/api/ig?tipo=story&id=:id"
    },
    {
      "source": "/ig/feed/:id.jpg",
      "destination": "/api/ig?tipo=feed&id=:id"
    },
    {
      "source": "/ig/fim.jpg",
      "destination": "/api/ig?tipo=fim"
    },
    {
      "source": "/ig/capa/:chave.jpg",
      "destination": "/api/ig?tipo=capa&chave=:chave"
    },
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/videos",
      "destination": "/api/home?pagina=videos"
    },
    {
      "source": "/n/:id",
      "destination": "/api/n?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/foto.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    },
    "api/card.js": {
      "maxDuration": 30,
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/n.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/img.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/aviso.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    },
    "api/home.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/sitemap.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/ig.js": {
      "maxDuration": 30,
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/ig-post.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/**,node_modules/ffmpeg-static/ffmpeg}"
    },
    "api/acompanha.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/promessas-busca.js": {
      "maxDuration": 300,
      "includeFiles": "lib/**",
      "regions": [
        "gru1"
      ]
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/p/:slug",
      "destination": "/deputado/:slug",
      "permanent": true
    }
  ]
}