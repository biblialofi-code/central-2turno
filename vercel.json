{
  "outputDirectory": "site",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dia-25",
      "destination": "/dia-25.html"
    },
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/videos",
      "destination": "/api/home?pagina=videos"
    },
    {
      "source": "/n/:id",
      "destination": "/api/n?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/foto.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    },
    "api/card.js": {
      "maxDuration": 30,
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/n.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/img.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/aviso.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    },
    "api/home.js": {
      "includeFiles": "{site/app.html,lib/**}"
    },
    "api/sitemap.js": {
      "includeFiles": "{site/app.html,lib/**}"
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}