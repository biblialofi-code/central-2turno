{
  "outputDirectory": "site",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/n/:id", "destination": "/api/n?id=:id" }
  ],
  "functions": {
    "api/foto.js": { "maxDuration": 60, "includeFiles": "{lib/**,node_modules/@fontsource/**/files/*-latin-*-normal.woff}" },
    "api/card.js": { "maxDuration": 30, "includeFiles": "{site/index.html,lib/**,node_modules/@fontsource/**/files/*-latin-*-normal.woff}" },
    "api/n.js": { "includeFiles": "site/index.html" },
    "api/img.js": { "includeFiles": "site/index.html" }
  }
}
